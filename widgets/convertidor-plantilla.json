{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "Última conversión",
      "size": "Small",
      "isSubtle": true,
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "${conversion}",
      "size": "ExtraLarge",
      "weight": "Bolder",
      "wrap": true
    },
    {
      "type": "ColumnSet",
      "columns": [
        { "type": "Column", "width": "stretch", "items": [
          { "type": "TextBlock", "text": "Celsius", "size": "Small", "isSubtle": true },
          { "type": "TextBlock", "text": "${celsius}", "weight": "Bolder" }
        ] },
        { "type": "Column", "width": "stretch", "items": [
          { "type": "TextBlock", "text": "Fahrenheit", "size": "Small", "isSubtle": true },
          { "type": "TextBlock", "text": "${fahrenheit}", "weight": "Bolder" }
        ] },
        { "type": "Column", "width": "stretch", "items": [
          { "type": "TextBlock", "text": "Kelvin", "size": "Small", "isSubtle": true },
          { "type": "TextBlock", "text": "${kelvin}", "weight": "Bolder" }
        ] }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${hora}",
      "size": "Small",
      "isSubtle": true,
      "wrap": true
    }
  ],
  "actions": [
    { "type": "Action.Execute", "title": "Abrir Convertidor", "verb": "abrir" },
    { "type": "Action.Execute", "title": "Nuevo", "verb": "nuevo" }
  ]
}
