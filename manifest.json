      "ms_ac_template": "widgets/convertidor-plantilla.json",
      "data": "widgets/convertidor-datos.json",
      "type": "application/json",
      "update": 3600,
      "icons": [
        { "src": "icons/icon512.png", "sizes": "512x512", "type": "image/png" }
      ],
      "screenshots": [
        { "src": "screenshots/widget.png", "sizes": "600x400", "label": "Widget con la última conversión" }
      ]
    }
  ]
}
