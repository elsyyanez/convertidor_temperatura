{
  "name": "Convertidor de temperatura",
  "short_name": "Convertidor de temperatura",
  "description": "Convierte entre Celsius, Fahrenheit y Kelvin.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay"],
  "lang": "es",
  "theme_color": "#fbe4ec",
  "background_color": "#fff7fa",
  "icons": [
    { "src": "icons/icon512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "screenshots": [
    { "src": "screenshots/app-wide.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Convertidor en escritorio" },
    { "src": "screenshots/app-narrow.png", "sizes": "540x720", "type": "image/png", "form_factor": "narrow", "label": "Convertidor en ventana estrecha" }
  ],
  "widgets": [
    {
      "name": "Última conversión",
